         (
          (
           GOAL_X + 2.0, -GOAL_WIDTH / 2, 0), (GOAL_X + 2.0, -GOAL_WIDTH / 2, GOAL_HEIGHT)),
         (
          (
           GOAL_X + 2.0, GOAL_WIDTH / 2, 0), (GOAL_X + 2.0, GOAL_WIDTH / 2, GOAL_HEIGHT)),
         (
          (
           GOAL_X, -GOAL_WIDTH / 2, GOAL_HEIGHT), (GOAL_X + 2.0, -GOAL_WIDTH / 2, GOAL_HEIGHT)),
