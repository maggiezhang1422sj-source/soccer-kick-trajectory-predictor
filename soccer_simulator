    def _make_grass_texture(self) -> "Texture":
        size = 256
        image = PNMImage(size, size, 3)
        rng = random.Random(31)
        for y in range(size):
            for x in range(size):
                stripe = 0.055 if x // 32 % 2 else -0.035
                fine = 0.012 * math.sin(y * 0.45 + x * 0.05) + rng.uniform(-0.012, 0.012)
                green = max(0.26, min(0.58, 0.39 + stripe + fine))
                image.setXel(x, y, 0.028, green, 0.095)

        for _ in range(700):
            x = rng.randrange(size)
            y = rng.randrange(size)
            length = rng.randrange(6, 15)
            shade = rng.uniform(0.34, 0.52)
            for step in range(length):
                px = min(size - 1, max(0, x + step))
                py = min(size - 1, max(0, y + rng.randrange(-1, 2)))
                image.setXel(px, py, 0.025, shade, 0.075)

        texture = Texture("procedural-grass-texture")
        texture.load(image)
        return texture

