        for (a, b) in posts:
            (segs.moveTo)(*a)
            (segs.drawTo)(*b)

        self.render.attachNewNode(segs.create())
        net = LineSegs("goal-net")
        net.setThickness(1)
        net.setColor(0.85, 0.92, 0.95, 0.55)
        for y_i in range(17):
            y = -GOAL_WIDTH / 2 + y_i * GOAL_WIDTH / 16
            net.moveTo(GOAL_NET_BACK_X, y, 0)
            net.drawTo(GOAL_NET_BACK_X, y, GOAL_HEIGHT)

        for z_i in range(9):
            z = z_i * GOAL_HEIGHT / 8
            net.moveTo(GOAL_NET_BACK_X, -GOAL_WIDTH / 2, z)
            net.drawTo(GOAL_NET_BACK_X, GOAL_WIDTH / 2, z)

        for y_i in range(17):
            y = -GOAL_WIDTH / 2 + y_i * GOAL_WIDTH / 16
            net.moveTo(GOAL_X, y, GOAL_HEIGHT)
            net.drawTo(GOAL_NET_BACK_X, y, GOAL_HEIGHT)

        for x_i in range(7):
            x = GOAL_X + x_i * GOAL_NET_DEPTH / 6
            net.moveTo(x, -GOAL_WIDTH / 2, GOAL_HEIGHT)
            net.drawTo(x, GOAL_WIDTH / 2, GOAL_HEIGHT)

        for side in (-1, 1):
            y = side * GOAL_WIDTH / 2
            for z_i in range(9):
                z = z_i * GOAL_HEIGHT / 8
                net.moveTo(GOAL_X, y, z)
                net.drawTo(GOAL_NET_BACK_X, y, z)

            for x_i in range(7):
                x = GOAL_X + x_i * GOAL_NET_DEPTH / 6
                net.moveTo(x, y, 0)
                net.drawTo(x, y, GOAL_HEIGHT)

