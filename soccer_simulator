    def _make_soccer_ball(self) -> "NodePath":
        ball = self._make_uv_sphere("soccer-ball", BALL_RADIUS, 64, 32)
        ball.setTexture(self._make_ball_texture(), 1)
        material = Material()
        material.setDiffuse((0.96, 0.96, 0.92, 1))
        material.setSpecular((0.28, 0.28, 0.25, 1))
        material.setShininess(18)
        ball.setMaterial(material, 1)
        return ball

    def _make_ball_texture(self) -> "Texture":
        size = 256
        image = PNMImage(size, size, 3)
        image.fill(0.93, 0.92, 0.86)
        panels = [
         (0.5, 0.5, 0.085, -90),
         (0.18, 0.5, 0.07, -90),
         (0.82, 0.5, 0.07, -90),
         (0.32, 0.25, 0.07, -72),
         (0.68, 0.25, 0.07, -108),
         (0.32, 0.75, 0.07, -108),
         (0.68, 0.75, 0.07, -72),
         (0.04, 0.22, 0.06, -90),
         (0.96, 0.78, 0.06, -90)]
        seam_lines = [
         (0.5, 0.5, 0.18),
         (0.18, 0.5, 0.15),
         (0.82, 0.5, 0.15),
         (0.32, 0.25, 0.15),
         (0.68, 0.25, 0.15),
         (0.32, 0.75, 0.15),
         (0.68, 0.75, 0.15)]
        panel_polygons = []
        for (cx, cy, radius, rotation) in panels:
            for wrapped_cx in (
             cx - 1.0, cx, cx + 1.0):
                polygon = self._regular_polygon_uv(wrapped_cx, cy, radius, 5, rotation)
                min_x = min((point[0] for point in polygon)) - 0.006
                max_x = max((point[0] for point in polygon)) + 0.006
                min_y = min((point[1] for point in polygon)) - 0.006
                max_y = max((point[1] for point in polygon)) + 0.006
                panel_polygons.append((polygon, min_x, max_x, min_y, max_y))

        for y in range(size):
            for x in range(size):
                u = x / size
                v = y / size
                black = False
                seam = False
                for (polygon, min_x, max_x, min_y, max_y) in panel_polygons:
                    if not min_x <= u <= max_x:
                        if not min_y <= v <= max_y:
                            pass
                        elif self._point_in_polygon(u, v, polygon):
                            black = True

                for (cx, cy, radius) in seam_lines:
                    dx = min(abs(u - cx), 1.0 - abs(u - cx))
                    dy = (v - cy) * 1.18
                    distance = math.sqrt(dx * dx + dy * dy)
                    if abs(distance - radius) < 0.0038:
                        seam = True
                    panel_noise = 0.012 * math.sin(u * 67.0 + v * 29.0) + 0.009 * math.sin(u * 19.0 - v * 53.0)

                if black:
                    highlight = 0.018 * math.sin(u * 41.0) + 0.014 * math.cos(v * 37.0)
                    shade = max(0.015, min(0.055, 0.032 + highlight))
                    image.setXel(x, y, shade, shade, shade)
                elif seam:
                    image.setXel(x, y, 0.08, 0.075, 0.065)
                else:
                    base = max(0.84, min(0.98, 0.925 + panel_noise))
                    image.setXel(x, y, base, base * 0.995, base * 0.94)

            texture = Texture("procedural-soccer-texture")
            texture.load(image)
            return texture

    @staticmethod
    def _regular_polygon_uv(cx, cy, radius, sides, rotation_deg):
        rotation = math.radians(rotation_deg)
        return [(
         cx + math.cos(rotation + 2.0 * math.pi * i / sides) * radius,
         cy + math.sin(rotation + 2.0 * math.pi * i / sides) * radius) for i in range(sides)]

    @staticmethod
    def _point_in_polygon(x, y, polygon):
        inside = False
        j = len(polygon) - 1
        for (i, (xi, yi)) in enumerate(polygon):
            (xj, yj) = polygon[j]
            intersects = (yi > y) != (yj > y) and x < (xj - xi) * (y - yi) / max(1e-06, yj - yi) + xi
            if intersects:
                inside = not inside
            j = i

        return inside

    @classmethod
    def _distance_to_poly_edges(cls, x, y, polygon):
        closest = 999.0
        for (i, start) in enumerate(polygon):
            end = polygon[(i + 1) % len(polygon)]
            closest = min(closest, cls._distance_to_segment(x, y, start, end))

        return closest

    @staticmethod
    def _distance_to_segment(x, y, start, end):
        (x1, y1) = start
        (x2, y2) = end
        dx = x2 - x1
        dy = y2 - y1
        length_sq = dx * dx + dy * dy
        if length_sq <= 1e-06:
            return math.sqrt((x - x1) ** 2 + (y - y1) ** 2)
        t = max(0.0, min(1.0, ((x - x1) * dx + (y - y1) * dy) / length_sq))
        px = x1 + t * dx
        py = y1 + t * dy
        return math.sqrt((x - px) ** 2 + (y - py) ** 2)

    def _make_uv_sphere(self, name, radius, segs, rings):
        fmt = GeomVertexFormat.getV3n3t2()
        vdata = GeomVertexData(name, fmt, Geom.UHStatic)
        vertex = GeomVertexWriter(vdata, "vertex")
        normal = GeomVertexWriter(vdata, "normal")
        texcoord = GeomVertexWriter(vdata, "texcoord")
        for r in range(rings + 1):
            theta = math.pi * r / rings
            z = math.cos(theta)
            ring_radius = math.sin(theta)
            for s in range(segs + 1):
                phi = 2 * math.pi * s / segs
                x = ring_radius * math.cos(phi)
                y = ring_radius * math.sin(phi)
                vertex.addData3(radius * x, radius * y, radius * z)
                normal.addData3(x, y, z)
                texcoord.addData2(s / segs, 1 - r / rings)

        tris = GeomTriangles(Geom.UHStatic)
        for r in range(rings):
            for s in range(segs):
                i0 = r * (segs + 1) + s
                i1 = i0 + 1
                i2 = i0 + segs + 1
                i3 = i2 + 1
                tris.addVertices(i0, i2, i1)
                tris.addVertices(i1, i2, i3)

        geom = Geom(vdata)
        geom.addPrimitive(tris)
        node = GeomNode(name)
        node.addGeom(geom)
        return NodePath(node)

    def _make_cylinder(self, name, radius, height, segs):
        fmt = GeomVertexFormat.getV3n3t2()
        vdata = GeomVertexData(name, fmt, Geom.UHStatic)
        vertex = GeomVertexWriter(vdata, "vertex")
        normal = GeomVertexWriter(vdata, "normal")
        texcoord = GeomVertexWriter(vdata, "texcoord")
        for (z_index, z) in enumerate((-height / 2, height / 2)):
            for s in range(segs + 1):
                angle = 2 * math.pi * s / segs
                x = math.cos(angle)
                y = math.sin(angle)
                vertex.addData3(radius * x, radius * y, z)
                normal.addData3(x, y, 0)
                texcoord.addData2(s / segs, z_index)

        bottom_center = vertex.getWriteRow()
        vertex.addData3(0, 0, -height / 2)
        normal.addData3(0, 0, -1)
        texcoord.addData2(0.5, 0.5)
        top_center = vertex.getWriteRow()
        vertex.addData3(0, 0, height / 2)
        normal.addData3(0, 0, 1)
        texcoord.addData2(0.5, 0.5)
        tris = GeomTriangles(Geom.UHStatic)
        ring = segs + 1
        for s in range(segs):
            i0 = s
            i1 = s + 1
            i2 = ring + s
            i3 = ring + s + 1
            tris.addVertices(i0, i1, i2)
            tris.addVertices(i1, i3, i2)
            tris.addVertices(bottom_center, i0, i1)
            tris.addVertices(top_center, i3, i2)

        geom = Geom(vdata)
        geom.addPrimitive(tris)
        node = GeomNode(name)
        node.addGeom(geom)
        return NodePath(node)

    def _start_shot(self, shot: "ShotData") -> "None":
        shot.speed_mps = max(3.0, min(55.0, shot.speed_mps))
        shot.launch_angle_deg = max(0.0, min(45.0, shot.launch_angle_deg))
        self._clear_trajectory()
        self.ball_start_pos = self._ball_position_from_shot(shot)
        if shot.direction_relative_to_goal:
            shot.direction_deg += self._direction_from_ball_to_goal(self.ball_start_pos)
        shot.direction_deg = max(-180.0, min(180.0, shot.direction_deg))
        shot.spin_rpm = max(-2500.0, min(2500.0, shot.spin_rpm))
        shot.side_spin_rpm = max(-2500.0, min(2500.0, shot.side_spin_rpm))
        launch = math.radians(shot.launch_angle_deg)
        direction = math.radians(shot.direction_deg)
        horizontal = shot.speed_mps * math.cos(launch)
        self.velocity = Vec3(horizontal * math.cos(direction), horizontal * math.sin(direction), shot.speed_mps * math.sin(launch))
        self.ball.setPos(self.ball_start_pos)
        self.previous_ball_pos = Vec3(self.ball_start_pos)
        self.trajectory_points.append(Vec3(self.ball_start_pos))
        self.ball.setHpr(0, 0, 0)
        self._update_direction_indicator(shot.direction_deg)
        self.flight_time = 0.0
        self.shot_active = True
        self.goal_line_passed = self.ball_start_pos.x >= GOAL_X - 0.1
        self.ball_landed = False
        self.goal_crossing_was_goal = False
        self.goal_scored = False
        self.net_contacted = False
        self.last_shot = shot
        self.goal_result = ""
        self.ai_corrected_for_shot = False
        self.status_since = time.time()
        self.status_label["text"] = "Ball kicked - tracking shot in FPV"
        shot_text = f"TCP :{UDP_PORT}   Speed {shot.speed_mps:.1f} m/s   Launch {shot.launch_angle_deg:.1f} deg   Dir {shot.direction_deg:.0f} deg   Pos {self._shot_distance_label(shot)}   Spin {shot.spin_rpm:.0f}/{shot.side_spin_rpm:.0f} rpm"
        if getattr(shot, "fsr_debug_text", ""):
            self.latest_fsr_debug_text = shot.fsr_debug_text
            self.fsr_debug_label["text"] = self.latest_fsr_debug_text
        self.status_label["text"] = f"Ball kicked - Mac ICM ignored\n{self.latest_fsr_debug_text}"
        self.telemetry_label["text"] = f"{shot_text}\n{self.latest_fsr_debug_text}"

    def _update(self, task):
        dt = globalClock.getDt()
        self._drain_udp_queue()
        self._animate_birds()
        if self.shot_active:
            self._step_ball(dt)
        elif self.replay_active:
            self._update_bird_view_replay(dt)
        else:
            self._maybe_start_random_shot()
            pulse = 0.55 + 0.45 * abs(math.sin(time.time() * 3.0))
            self.status_label["text_fg"] = (1.0, 0.86 + 0.14 * pulse, 0.32, 1)
            self._idle_camera(dt)
        return task.cont

    def _animate_birds(self) -> "None":
        t = time.time()
        for (i, bird) in enumerate(self.birds):
            bird.setX(bird.getX() + 0.006 + i * 0.0007)
            bird.setZ(bird.getZ() + math.sin(t * 2.2 + i) * 0.002)
            bird.setR(math.sin(t * 4.2 + i) * 3.0)
            if bird.getX() > FIELD_LENGTH / 2 + 30:
                bird.setX(24)

    def _drain_udp_queue(self) -> "None":
        newest_debug = None
        while True:
            try:
                newest_debug = self.udp_debug_queue.get_nowait()
            except queue.Empty:
                break

        if newest_debug and not self.shot_active:
            if not self.replay_active:
                self.status_label["text"] = newest_debug
                self.status_label["text_fg"] = (0.76, 0.92, 1.0, 1)
                self.telemetry_label["text"] = f"TCP :{UDP_PORT}   {newest_debug}"

        newest = None
        while True:
            try:
                newest = self.shot_queue.get_nowait()
            except queue.Empty:
                break

        if newest and not self.shot_active and not self.replay_active:
            self._start_shot(newest)

    def _step_ball(self, dt: "float") -> "None":
        dt = min(dt, 0.03333333333333333) * 0.8
        shot = self.last_shot or ShotData(20, 16)
        pos = self.ball.getPos()
        previous_pos = Vec3(pos)
        accel = self._magnus_acceleration(shot)
        self.velocity += accel * dt
        pos += self.velocity * dt
        self._apply_goal_net_collision(pos)
        ground_hit = pos.z <= BALL_RADIUS and self.velocity.z < 0
        if ground_hit:
            self.ball_landed = True
            pos.z = BALL_RADIUS
            self.velocity.z *= -0.34
            self.velocity.x *= 0.78
            self.velocity.y *= 0.8
        self.ball.setPos(pos)
        if not self.trajectory_points or (pos - self.trajectory_points[-1]).length() > 0.45:
            self.trajectory_points.append(Vec3(pos))
        spin_degrees = self.velocity.length() / (2 * math.pi * BALL_RADIUS) * 360 * dt
        self.ball.setP(self.ball.getP() + spin_degrees)
        self.ball.setH(self.ball.getH() + shot.side_spin_rpm * 6.0 * dt)
        self.flight_time += dt
        self._follow_ball_camera(dt)
        self._check_goal_or_stop(previous_pos, pos)
        self.previous_ball_pos = Vec3(pos)

    def _magnus_acceleration(self, shot: "ShotData") -> "Vec3":
        horizontal_velocity = Vec3(self.velocity.x, self.velocity.y, 0)
        horizontal_speed = horizontal_velocity.length()
        accel = Vec3(0, 0, -GRAVITY)
        if horizontal_speed < 0.01:
            return accel
        forward = Vec3(horizontal_velocity)
        forward.normalize()
        right = Vec3(-forward.y, forward.x, 0)
        side_spin_ratio = max(-1.0, min(1.0, shot.side_spin_rpm / 1800.0))
        backspin_ratio = max(-1.0, min(1.0, shot.spin_rpm / 2200.0))
        curl_strength = side_spin_ratio * horizontal_speed * 0.34 * shot.magnus_curl_scale
        lift_strength = abs(backspin_ratio) * horizontal_speed * 0.16 * shot.magnus_lift_scale
        drag_strength = min(1.8, horizontal_speed * 0.018 * shot.drag_scale)
        accel -= right * curl_strength
        accel += Vec3(0, 0, lift_strength)
        accel -= forward * drag_strength
        return accel

    def _apply_goal_net_collision(self, pos: "Vec3") -> "None":
        in_goal_mouth = abs(pos.y) <= GOAL_WIDTH / 2 + BALL_RADIUS and BALL_RADIUS <= pos.z <= GOAL_HEIGHT + BALL_RADIUS
        if not in_goal_mouth or pos.x < GOAL_X:
            return
        net_back_x = GOAL_NET_BACK_X - BALL_RADIUS
        if pos.x >= net_back_x:
            pos.x = net_back_x
            if self.velocity.x > 0:
                self.velocity.x *= -0.1
            self.velocity.y *= 0.45
            self.velocity.z *= 0.45
            self.net_contacted = True
            return
        if not self.net_contacted:
            self.velocity.x *= 0.22
            self.velocity.y *= 0.55
            self.velocity.z *= 0.6
            self.net_contacted = True
        side_limit = GOAL_WIDTH / 2 - BALL_RADIUS
        if pos.y > side_limit:
            pos.y = side_limit
            self.velocity.y = min(0.0, self.velocity.y) * 0.25
        elif pos.y < -side_limit:
            pos.y = -side_limit
            self.velocity.y = max(0.0, self.velocity.y) * 0.25
        top_limit = GOAL_HEIGHT - BALL_RADIUS
        if pos.z > top_limit:
            pos.z = top_limit
            self.velocity.z = min(0.0, self.velocity.z) * 0.25

    def _check_goal_or_stop(self, previous_pos: "Vec3", pos: "Vec3") -> "None":
        crossed_goal_plane, entered_goal = self._goal_plane_crossing(previous_pos, pos)
        in_goal = entered_goal or (
            abs(pos.x - GOAL_X) <= 0.45
            and abs(pos.y) <= GOAL_WIDTH / 2
            and BALL_RADIUS < pos.z <= GOAL_HEIGHT
        )
        if in_goal and not self.goal_scored:
            self.goal_scored = True
            self.goal_result = "Goal!"
            self.status_label["text"] = self.goal_result
            self.status_label["text_fg"] = (0.20, 1.0, 0.42, 1)

        if not self.goal_line_passed and (in_goal or crossed_goal_plane):
            self.goal_line_passed = True
            self.goal_crossing_was_goal = in_goal
            self.goal_result = "Goal!" if self.goal_scored else "Missed - waiting for ball to land"
            self.status_label["text"] = self.goal_result
            self.status_label["text_fg"] = (0.20, 1.0, 0.42, 1) if self.goal_scored else (1.0, 0.64, 0.28, 1)

        net_back_reached = (
            previous_pos.x < GOAL_NET_BACK_X <= pos.x
            or pos.x >= GOAL_NET_BACK_X
            or (self.net_contacted and pos.x >= GOAL_NET_BACK_X - BALL_RADIUS - 0.01)
        )
        if net_back_reached:
            if self.goal_scored:
                self.goal_result = "Goal!"
                self.status_label["text"] = self.goal_result
                self.status_label["text_fg"] = (0.20, 1.0, 0.42, 1)
            else:
                self.goal_result = "Shot passed behind the net - replaying"
                self.status_label["text"] = self.goal_result
                self.status_label["text_fg"] = (1.0, 0.64, 0.28, 1)
            self.shot_active = False
            self.status_since = time.time()
            self._start_bird_view_replay()
            return

        ball_stopped = self.ball_landed and self.velocity.length() < 0.45
        if self.goal_line_passed and ball_stopped:
            if self.goal_scored:
                self.goal_result = "Goal!"
                self.status_label["text"] = self.goal_result
                self.status_label["text_fg"] = (0.20, 1.0, 0.42, 1)
            elif not self.goal_result or self.goal_result.startswith("Missed"):
                self.goal_result = "Missed - replaying after landing"
                self.status_label["text"] = self.goal_result
                self.status_label["text_fg"] = (1.0, 0.38, 0.28, 1)
            self.shot_active = False
            self.status_since = time.time()
            self._start_bird_view_replay()
        elif self.flight_time > 18.0 or (ball_stopped and not self.goal_line_passed):
            self.status_label["text"] = "Shot finished - kick the ball again"
            self.status_label["text_fg"] = (1.0, 0.86, 0.32, 1)
            self.shot_active = False
            self.status_since = time.time()
            self._start_bird_view_replay()

    @staticmethod
    def _goal_plane_crossing(previous_pos: "Vec3", pos: "Vec3") -> "Tuple[bool, bool]":
        dx0 = previous_pos.x - GOAL_X
        dx1 = pos.x - GOAL_X
        crossed = dx0 == 0 or dx1 == 0 or dx0 < 0 < dx1 or dx1 < 0 < dx0
        if not crossed:
            return (False, False)
        segment_dx = pos.x - previous_pos.x
        if abs(segment_dx) < 0.0001:
            t = 0.0
        else:
            t = max(0.0, min(1.0, (GOAL_X - previous_pos.x) / segment_dx))
        y_at_goal = previous_pos.y + (pos.y - previous_pos.y) * t
        z_at_goal = previous_pos.z + (pos.z - previous_pos.z) * t
        entered_goal = abs(y_at_goal) <= GOAL_WIDTH / 2 and BALL_RADIUS < z_at_goal <= GOAL_HEIGHT
        return (
         True, entered_goal)

    def _follow_ball_camera(self, dt: "float") -> "None":
        if not self.camera:
            return
        ball_pos = self.ball.getPos()
        direction = Vec3(self.velocity.x, self.velocity.y, max(self.velocity.z * 0.25, 0.0))
        if direction.length() < 0.01:
            direction = Vec3(1, 0, 0)
        direction.normalize()
        desired = ball_pos - direction * 2.2 + Vec3(0, 0, 0.75)
        current = self.camera.getPos()
        blend = min(1.0, dt * 7.5)
        self.camera.setPos(current + (desired - current) * blend)
        self.camera.lookAt(ball_pos + direction * 4.0 + Vec3(0, 0, 0.45))

    def _start_bird_view_replay(self) -> "None":
        if len(self.trajectory_points) < 2:
            self._schedule_next_random_shot()
            return
        self._self_correct_ai_model()
        self.replay_active = True
        self.replay_started_at = time.time()
        self.replay_draw_index = 1
        self.replay_draw_progress = 1.0
        self._clear_trajectory_line_only()
        self.status_label["text"] = "Goal! - 3D slow-motion replay" if self.goal_scored else "3D slow-motion bird view replay"
        self.status_label["text_fg"] = (0.76, 0.92, 1.0, 1)
        self._set_sky_details_visible(False)

    def _self_correct_ai_model(self) -> "None":
        if self.ai_corrected_for_shot or not self.last_shot:
            return
        message = KICK_AI_MODEL.self_correct(self.last_shot, self.trajectory_points, self.goal_scored)
        self.ai_corrected_for_shot = True
        if message:
            print(message)
        self._set_bird_view_camera()

    def _update_bird_view_replay(self, dt: "float") -> "None":
        if not self.camera:
            return
        self._set_bird_view_camera()
        self.replay_draw_progress = min(len(self.trajectory_points), self.replay_draw_progress + 14.0 * dt)
        self.replay_draw_index = max(1, int(self.replay_draw_progress))
        self._draw_trajectory(self.replay_draw_index)
        current = self.trajectory_points[self.replay_draw_index - 1]
        self.ball.setPos(current)
        self.ball.setZ(max(BALL_RADIUS, current.z))
        if self.replay_draw_index >= len(self.trajectory_points):
            if time.time() - self.replay_started_at > 2.0:
                self.replay_active = False
                self.status_label["text"] = "Trajectory replay complete - kick the ball again"
                self.status_label["text_fg"] = (1.0, 0.9, 0.35, 1)
                self._set_sky_details_visible(True)
                self._schedule_next_random_shot(delay=3.0)

    def _set_bird_view_camera(self) -> "None":
        if not self.camera:
            return
        min_x = min((point.x for point in self.trajectory_points))
        max_x = max((point.x for point in self.trajectory_points))
        min_y = min((point.y for point in self.trajectory_points))
        max_y = max((point.y for point in self.trajectory_points))
        max_z = max((point.z for point in self.trajectory_points))
        center = Vec3((min_x + max_x) * 0.5, (min_y + max_y) * 0.5, max(1.0, max_z * 0.35))
        span = max(max_x - min_x, max_y - min_y, 32.0)
        height = min(110.0, max(42.0, span * 1.45 + max_z * 2.0))
        self.camera.setPos(center.x - span * 0.18, center.y - span * 0.22, height)
        self.camera.lookAt(center)

    def _draw_trajectory(self, count: "int") -> "None":
        self._clear_trajectory_line_only()
        if count < 2:
            return
        lines = LineSegs("bird-view-trajectory")
        lines.setThickness(4.0)
        lines.setColor(1.0, 0.18, 0.12, 1.0)
        first = self.trajectory_points[0]
        lines.moveTo(first.x, first.y, max(0.18, first.z))
        for point in self.trajectory_points[1:count]:
            lines.drawTo(point.x, point.y, max(0.18, point.z))

        self.trajectory_line_np = self.render.attachNewNode(lines.create())

    def _clear_trajectory(self) -> "None":
        self.trajectory_points = []
        self.replay_active = False
        self.replay_draw_index = 0
        self.replay_draw_progress = 0.0
        self._set_sky_details_visible(True)
        self._clear_trajectory_line_only()

    def _clear_trajectory_line_only(self) -> "None":
        if self.trajectory_line_np:
            self.trajectory_line_np.removeNode()
            self.trajectory_line_np = None

    def _set_sky_details_visible(self, visible: "bool") -> "None":
        for node in self.clouds + self.birds:
            if visible:
                node.show()
            else:
                node.hide()

    def _idle_camera(self, dt: "float") -> "None":
        if not self.camera:
            return
        (desired, target) = self._pre_kick_camera_pose(wiggle=True)
        self.camera.setPos(self.camera.getPos() + (desired - self.camera.getPos()) * min(1.0, dt * 2.0))
        self.camera.lookAt(target)

    def _reset_camera(self) -> "None":
        if not self.camera:
            return
        (desired, target) = self._pre_kick_camera_pose(wiggle=False)
        self.camera.setPos(desired)
        self.camera.lookAt(target)

    def _update_direction_indicator(self, direction_deg: "float") -> "None":
        if self.direction_line_np:
            self.direction_line_np.removeNode()
        direction = math.radians(direction_deg)
        forward = Vec3(math.cos(direction), math.sin(direction), 0)
        right = Vec3(-forward.y, forward.x, 0)
        start = Vec3(self.ball_start_pos.x, self.ball_start_pos.y, 0.09)
        length = min(14.0, max(5.0, self.shot_distance_m * 0.32))
        end = start + forward * length
        lines = LineSegs("initial-direction")
        lines.setThickness(4.0)
        lines.setColor(1.0, 0.86, 0.12, 1.0)
        lines.moveTo(start)
        lines.drawTo(end)
        lines.moveTo(end)
        lines.drawTo(end - forward * 1.25 + right * 0.65)
        lines.moveTo(end)
        lines.drawTo(end - forward * 1.25 - right * 0.65)
        self.direction_line_np = self.render.attachNewNode(lines.create())

    def _pre_kick_camera_pose(self, wiggle: "bool") -> "Tuple[Vec3, Vec3]":
        distance = 4.0
        to_goal = Vec3(GOAL_X - self.ball_start_pos.x, -self.ball_start_pos.y, 0)
        if to_goal.length() < 0.001:
            to_goal = Vec3(1, 0, 0)
        to_goal.normalize()
        lateral = Vec3(-to_goal.y, to_goal.x, 0)
        behind_offset = -to_goal * distance + Vec3(0, 0, 1.8)
        wiggle_pos = Vec3(0, 0, 0)
        wiggle_target = Vec3(0, 0, 0)
        if wiggle:
            t = time.time()
            wiggle_pos = lateral * (math.sin(t * 1.35) * 0.12) + Vec3(0, 0, math.sin(t * 1.9) * 0.035)
            wiggle_target = lateral * (math.sin(t * 1.1) * 0.18) + Vec3(0, 0, math.sin(t * 1.6) * 0.04)
        camera_pos = self.ball_start_pos + behind_offset + wiggle_pos
        target = Vec3(GOAL_X, 0, GOAL_HEIGHT * 0.55) + wiggle_target
        return (
         camera_pos, target)

    def _reset_ball(self) -> "None":
        self.ball_start_pos = self._ball_position_from_selected_controls()
        self.ball.setPos(self.ball_start_pos)
        self.previous_ball_pos = Vec3(self.ball_start_pos)
        self.ball.setHpr(0, 0, 0)
        self.velocity = Vec3(0, 0, 0)
        self.shot_active = False
        self.goal_line_passed = False
        self.ball_landed = False
        self.goal_crossing_was_goal = False
        self.goal_scored = False
        self.net_contacted = False
        self.ai_corrected_for_shot = False
        self._clear_trajectory()
        self.goal_result = ""
        self.status_label["text"] = self._waiting_status_text()
        self.status_label["text_fg"] = (1.0, 0.9, 0.35, 1)
        self.latest_fsr_debug_text = "FSR DEBUG VISIBLE - MAC IGNORES ICM FOR LAUNCH\nwaiting for SKC1 baseline-corrected FSR buffer"
        self.fsr_debug_label["text"] = self.latest_fsr_debug_text
        self.telemetry_label["text"] = f"TCP :{UDP_PORT}   Speed -- m/s   Launch -- deg   Dir -- deg   Spin -- rpm\n{self.latest_fsr_debug_text}"
        self._schedule_next_random_shot(delay=0.8)
        self._reset_camera()
        self._update_direction_indicator(self._direction_from_ball_to_goal(self.ball_start_pos))

    def _demo_shot(self) -> "None":
        self._start_shot(self._shot_from_selected_controls(spin_rpm=900.0, side_spin_rpm=850.0))

    def _cycle_shot_distance(self, direction: "int") -> "None":
        self.shot_distance_index = (self.shot_distance_index + direction) % len(self.shot_distance_choices)
        self.shot_distance_m = self.shot_distance_choices[self.shot_distance_index][1]
        self.distance_label["text"] = self.shot_distance_choices[self.shot_distance_index][0]
        if not self.shot_active:
            self._reset_ball()

    def _cycle_shot_angle(self, direction: "int") -> "None":
        self.shot_angle_index = (self.shot_angle_index + direction) % len(self.shot_angle_choices)
        self.shot_angle_deg = self.shot_angle_choices[self.shot_angle_index][1]
        self.angle_label["text"] = self.shot_angle_choices[self.shot_angle_index][0]
        if not self.shot_active:
            self._reset_ball()

    def _shot_from_selected_controls(self, spin_rpm: "float", side_spin_rpm: "float") -> "ShotData":
        launch_angle_deg = 15.0
        speed = self._speed_for_target_distance(self.shot_distance_m, launch_angle_deg)
        direction = self._direction_from_ball_to_goal(self.ball_start_pos)
        return ShotData(speed_mps=speed,
          launch_angle_deg=launch_angle_deg,
          direction_deg=direction,
          spin_rpm=spin_rpm,
          side_spin_rpm=side_spin_rpm,
          ball_distance_m=(self.shot_distance_m),
          ball_position_angle_deg=(self.shot_angle_deg))

    def _ball_position_from_selected_controls(self) -> "Vec3":
        return self._ball_position_from_distance_angle(self.shot_distance_m, self.shot_angle_deg)

    def _ball_position_from_shot(self, shot: "ShotData") -> "Vec3":
        if shot.ball_distance_m is None or shot.ball_position_angle_deg is None:
            return self._ball_position_from_selected_controls()
        return self._ball_position_from_distance_angle(max(1.0, min(140.0, shot.ball_distance_m)), max(0.0, min(180.0, shot.ball_position_angle_deg)))

    @staticmethod
    def _ball_position_from_distance_angle(distance_m: "float", angle_deg: "float") -> "Vec3":
        angle = math.radians(angle_deg)
        direction_from_ball_to_goal = Vec3(math.sin(angle), math.cos(angle), 0)
        goal_ground = Vec3(GOAL_X, 0, BALL_RADIUS)
        return goal_ground - direction_from_ball_to_goal * distance_m

    def _shot_distance_label(self, shot: "ShotData") -> "str":
        distance = shot.ball_distance_m if shot.ball_distance_m is not None else self.shot_distance_m
        angle = shot.ball_position_angle_deg if shot.ball_position_angle_deg is not None else self.shot_angle_deg
        return f"{distance:.0f} m/{angle:.0f} deg"

    @staticmethod
    def _direction_from_ball_to_goal(ball_pos: "Vec3") -> "float":
        to_goal = Vec3(GOAL_X - ball_pos.x, -ball_pos.y, 0)
        if to_goal.length() < 0.001:
            return 0.0
        return math.degrees(math.atan2(to_goal.y, to_goal.x))

    @staticmethod
    def _speed_for_target_distance(distance_m: "float", launch_angle_deg: "float") -> "float":
        angle = math.radians(max(1.0, min(44.0, launch_angle_deg)))
        denominator = max(0.05, math.sin(2.0 * angle))
        return math.sqrt(max(1.0, distance_m) * GRAVITY / denominator)

    def _toggle_random_loop(self) -> "None":
        self.random_loop_enabled = False
        self.random_button["text"] = "UDP Listen"
        self.random_button["frameColor"] = (0.13, 0.3, 0.54, 1)
        self.status_label["text"] = "Waiting for ESP32 TCP kick packets"

    def _maybe_start_random_shot(self) -> "None":
        if self.random_loop_enabled:
            if self.shot_active or time.time() < self.next_random_shot_at:
                return
            packet = self._generate_random_kick_packet()
            shot = TcpKickListener._parse_packet(packet)
            if shot:
                self._start_shot(shot)
                self.status_label["text"] = "Random kick packet generated"

    def _schedule_next_random_shot(self, delay: "Optional[float]"=None) -> "None":
        wait_time = delay if delay is not None else random.uniform(1.1, 2.4)
        self.next_random_shot_at = time.time() + wait_time

    def _generate_random_kick_packet(self) -> "str":
        selected_shot = self._shot_from_selected_controls(spin_rpm=0.0, side_spin_rpm=0.0)
        speed = selected_shot.speed_mps * random.uniform(0.94, 1.06)
        launch_angle = selected_shot.launch_angle_deg + random.uniform(-2.0, 2.0)
        direction = selected_shot.direction_deg + random.uniform(-12.0, 12.0)
        spin = random.triangular(100.0, 2100.0, 850.0)
        side_spin = random.triangular(-1400.0, 1400.0, 0.0)
        packet = {'kicked':True, 
         'speed_mps':round(speed, 2), 
         'launch_angle_deg':round(launch_angle, 2), 
         'direction_deg':round(max(-180.0, min(180.0, direction)), 2), 
         'spin_rpm':round(spin, 1), 
         'side_spin_rpm':round(max(-1400.0, min(1400.0, side_spin)), 1)}
        return json.dumps(packet)

    def _waiting_status_text(self) -> "str":
        if self.udp_error:
            return f"TCP listener unavailable ({self.udp_error}) - Demo Shot still works"
        return "Kick the ball - waiting for ESP32 TCP signal"

    @staticmethod
    def _line(lines, x0, y0, z0, x1, y1, z1):
        lines.moveTo(x0, y0, z0)
        lines.drawTo(x1, y1, z1)

    @staticmethod
    def _rect_line(lines, x0, x1, y0, y1, z):
        lines.moveTo(x0, y0, z)
        lines.drawTo(x1, y0, z)
        lines.drawTo(x1, y1, z)
        lines.drawTo(x0, y1, z)
        lines.drawTo(x0, y0, z)

    @staticmethod
    def _circle(lines, x, y, radius):
        steps = 96
        for i in range(steps + 1):
            a = 2 * math.pi * i / steps
            px = x + math.cos(a) * radius
            py = y + math.sin(a) * radius
            if i == 0:
                lines.moveTo(px, py, 0.04)
            else:
                lines.drawTo(px, py, 0.04)


