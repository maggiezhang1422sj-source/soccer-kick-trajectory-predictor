                chunk_count,
                sample_count,
                start_sample,
                row_count,
                _sample_hz,
                accel_scale,
                gyro_scale,
                _fsr_threshold,
                _motion_speed,
                _motion_accel,
            ) = struct.unpack_from(header_format, payload, 0)
            if magic != b"SKC1" or sample_count <= 0 or row_count <= 0 or chunk_count <= 0:
                return None
            expected_size = header_size + base_size + max(0, row_count - 1) * delta_size
            if len(payload) < expected_size:
                return None
            offset = header_size
            current = list(struct.unpack_from(base_format, payload, offset))
            offset += base_size
            rows = [TcpKickListener._decode_quantized_sample(current, float(accel_scale), float(gyro_scale))]
            for _ in range(row_count - 1):
                delta = struct.unpack_from(delta_format, payload, offset)
                offset += delta_size
                current = [current[i] + int(delta[i]) for i in range(11)]
                rows.append(TcpKickListener._decode_quantized_sample(current, float(accel_scale), float(gyro_scale)))
        except (struct.error, ZeroDivisionError):
            return None

        now = time.time()
        for completed_sequence in [seq for seq, completed_at in self._completed_sequences.items() if now - completed_at > 4.0]:
            del self._completed_sequences[completed_sequence]
        if sequence_id in self._completed_sequences:
            return None
        for stale_sequence in [seq for seq, packet in self._chunked_sensor_packets.items() if now - packet["updated_at"] > 4.0]:
            del self._chunked_sensor_packets[stale_sequence]

        packet = self._chunked_sensor_packets.setdefault(
            sequence_id,
            {
                "sample_count": sample_count,
                "chunk_count": chunk_count,
                "chunks": {},
                "updated_at": now,
            },
        )
        packet["updated_at"] = now
        packet["chunks"][start_sample] = rows
        received_rows = sum(len(chunk_rows) for chunk_rows in packet["chunks"].values())
        self._debug(f"Chunk {chunk_index + 1}/{chunk_count} seq={sequence_id} rows={received_rows}/{sample_count}")
        if len(packet["chunks"]) < chunk_count or received_rows < sample_count:
            return None

        samples = []
        for start in sorted(packet["chunks"]):
            samples.extend(packet["chunks"][start])
        del self._chunked_sensor_packets[sequence_id]
        self._completed_sequences[sequence_id] = now
        complete_message = f"Complete sensor buffer: {len(samples[:sample_count])} samples in {chunk_count} chunks"
        self._debug(complete_message)
        print(complete_message)
        return TcpKickListener._shot_from_sensor_samples(samples[:sample_count], None, None)

    @staticmethod
    def _shot_from_sensor_samples(samples, distance, angle):
        features = KICK_AI_MODEL.features_from_samples(samples)
        if not features:
            return
        shot = KICK_AI_MODEL.predict(features, distance, angle)
        fsr_debug_text = (
            "FSR "
            f"peak=[{features['fsr0_raw']:.0f}, {features['fsr1_raw']:.0f}, {features['fsr2_raw']:.0f}, {features['fsr3_raw']:.0f}] "
            f"impulse=[{features['fsr0_signal']:.2f}, {features['fsr1_signal']:.2f}, {features['fsr2_signal']:.2f}, {features['fsr3_signal']:.2f}]\n"
            f"outer={features['outer_pressure']:.2f} inner={features['inner_pressure']:.2f} "
            f"upper={features['upper_pressure']:.2f} lower={features['lower_pressure']:.2f} "
            f"side_bias={features['side_bias']:.3f} vertical_bias={features['vertical_bias']:.3f}\n"
            f"peak_dt outer-inner={features['outer_inner_peak_dt_s'] * 1000.0:.2f}ms "
            f"upper-lower={features['upper_lower_peak_dt_s'] * 1000.0:.2f}ms "
            f"side_attack={features.get('side_attack_angle_deg', 0.0):.1f}deg "
            f"back_attack={features.get('back_attack_angle_deg', 0.0):.1f}deg"
        )
        print(fsr_debug_text)
        shot.fsr_debug_text = fsr_debug_text
        return shot

    @staticmethod
    def _decode_sensor_samples(data: "dict") -> "list[list[float]]":
        if data.get("encoding") == "delta":
            base = data.get("base")
            deltas = data.get("deltas", [])
            if not isinstance(base, list) or len(base) < 11:
                return []
            accel_scale = float(data.get("accel_scale", 100.0))
            gyro_scale = float(data.get("gyro_scale", 10.0))
            samples = []
            try:
                current = [int(value) for value in base[:11]]
                samples.append(TcpKickListener._decode_quantized_sample(current, accel_scale, gyro_scale))
                for row in deltas:
                    if isinstance(row, list):
                        if len(row) < 11:
                            pass
                        else:
                            diff = [int(value) for value in row[:11]]
                            current = [current[i] + diff[i] for i in range(11)]
                            samples.append(TcpKickListener._decode_quantized_sample(current, accel_scale, gyro_scale))

            except (TypeError, ValueError, ZeroDivisionError):
                return []
            else:
                return samples
        samples = []
        for row in data.get("samples", []):
            if isinstance(row, list) and len(row) >= 11:
                try:
                    samples.append([float(value) for value in row[:11]])
                except (TypeError, ValueError):
                    continue
        return samples

    @staticmethod
    def _decode_quantized_sample(row, accel_scale, gyro_scale):
        return [
         float(row[0]),
         float(row[1]),
         float(row[2]),
         float(row[3]),
         float(row[4]),
         row[5] / accel_scale,
         row[6] / accel_scale,
         row[7] / accel_scale,
         row[8] / gyro_scale,
         row[9] / gyro_scale,
         row[10] / gyro_scale]

    @staticmethod
    def _goal_direction_from_distance_angle(distance_m: "Optional[float]", angle_deg: "Optional[float]") -> "float":
        if distance_m is None or angle_deg is None:
            return 0.0
        angle = math.radians(angle_deg)
        ball_x = GOAL_X - math.sin(angle) * distance_m
        ball_y = -math.cos(angle) * distance_m
        return math.degrees(math.atan2(-ball_y, GOAL_X - ball_x))

    @staticmethod
    def _clamp(value, low, high):
        return max(low, min(high, value))


