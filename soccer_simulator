                puff.setScale(size * 4.8 * scale, 0.85 * scale, size * 1.25 * scale)
                puff.setPos(dx * scale, 0, dz * scale)
                puff.setColor(1.0, 1.0, 1.0, 0.72)
                puff.setTransparency(TransparencyAttrib.MAlpha)

            cloud.setPos(x, y, z)
            self.clouds.append(cloud)

    def _make_birds(self) -> "None":
